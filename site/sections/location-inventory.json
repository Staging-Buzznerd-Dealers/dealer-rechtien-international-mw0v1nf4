{
  "version": 2,
  "id": "location-inventory",
  "name": "Location inventory",
  "description": "Live inventory assigned to one rooftop, with links that widen the search to every location.",
  "props": [
    { "key": "locationSlug", "type": "text", "label": "Location (filled in per page)" },
    { "key": "eyebrow", "type": "text", "label": "Eyebrow", "default": "In stock here" },
    { "key": "intro", "type": "textarea", "label": "Intro", "default": "New and used units assigned to this store. Can't find the right spec? Widen the search to every location." },
    {
      "key": "rooftop",
      "type": "list",
      "label": "Location",
      "fields": [
        { "key": "name", "type": "text", "label": "Name" },
        { "key": "slug", "type": "text", "label": "Slug" }
      ]
    }
  ],
  "nodes": [
    {
      "id": "li",
      "type": "section",
      "props": { "width": "boxed", "paddingY": 8, "anchor": "inventory" },
      "children": [
        {
          "id": "li-head",
          "type": "row",
          "props": { "gap": 6, "stackOn": "tablet" },
          "children": [
            {
              "id": "li-copy",
              "type": "column",
              "props": { "span": 7, "repeat": "rooftop" },
              "children": [
                { "id": "li-h", "type": "heading", "props": { "text": "Trucks at {{name}}", "headingLevel": 2, "align": "left", "eyebrow": "{{eyebrow}}" } },
                { "id": "li-intro", "type": "text", "props": { "text": "{{intro}}", "align": "left", "width": "full" } }
              ]
            },
            {
              "id": "li-links",
              "type": "column",
              "props": { "span": 5, "repeat": "rooftop" },
              "children": [
                {
                  "id": "li-btns",
                  "type": "buttons",
                  "props": {
                    "align": "left",
                    "items": [
                      { "ctaId": "see-available", "label": "All {{name}} inventory", "url": "/store/inventory?location={{slug}}", "style": "secondary" },
                      { "ctaId": "browse-trucks", "label": "Search every location", "url": "/store/inventory", "style": "link" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "li-row",
          "type": "row",
          "props": { "gap": 0 },
          "children": [
            {
              "id": "li-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                { "id": "li-stock", "type": "widget", "props": { "widget": "inventory-carousel", "config": { "locationSlug": "{{locationSlug}}" } } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "css": ".bz-section[data-bz-node=\"li\"]{padding-block:clamp(56px,6vw,88px)}\n[data-bz-node=\"li\"] .bz-block{padding-block:0}\n[data-bz-node^=\"li-intro\"] p{max-width:36rem;margin:0}\n[data-bz-node^=\"li-links\"]{display:flex;align-items:flex-end;justify-content:flex-end}\n[data-bz-node^=\"li-btns\"] .bz-btns{align-items:center;gap:24px;margin:0}\n[data-bz-node=\"li-row\"]{margin-top:var(--space-5)}\n@media (max-width:1100px){[data-bz-node^=\"li-links\"]{justify-content:flex-start}}\n"
}
