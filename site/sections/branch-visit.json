{
  "version": 2,
  "id": "branch-visit",
  "name": "Branch card",
  "description": "The name, address, phone and directions of one branch, read live from Admin → Locations. Point the placement at a branch with its slug.",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "Find the body shop"
    },
    {
      "key": "rooftop",
      "type": "list",
      "label": "Location",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "streetAddress",
          "type": "text",
          "label": "Street address"
        },
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        },
        {
          "key": "postalCode",
          "type": "text",
          "label": "Postal code"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link"
        },
        {
          "key": "mapUrl",
          "type": "url",
          "label": "Directions link"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "bv",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0
      },
      "children": [
        {
          "id": "bv-row",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "children": [
            {
              "id": "bv-col",
              "type": "column",
              "props": {
                "span": 12,
                "repeat": "rooftop"
              },
              "children": [
                {
                  "id": "bv-h",
                  "type": "heading",
                  "props": {
                    "text": "{{name}}",
                    "headingLevel": 2,
                    "align": "center",
                    "eyebrow": "{{eyebrow}}"
                  }
                },
                {
                  "id": "bv-addr",
                  "type": "text",
                  "props": {
                    "text": "{{streetAddress}}, {{city}}, {{region}} {{postalCode}}",
                    "width": "full",
                    "align": "center"
                  }
                },
                {
                  "id": "bv-cta",
                  "type": "buttons",
                  "props": {
                    "align": "center",
                    "items": [
                      {
                        "ctaId": "call-us",
                        "label": "Call {{phone}}",
                        "url": "{{phoneUrl}}",
                        "style": "primary"
                      },
                      {
                        "ctaId": "get-directions",
                        "url": "{{mapUrl}}",
                        "style": "primary"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "css": "/* Branch card: the rooftop's name, address, phone and directions from Admin → Locations. Nothing is typed in; without a published location the band does not show. */\n.bz-section[data-bz-node=\"bv\"]:not(:has([data-bz-node^=\"bv-col\"])){display:none}\n.bz-section[data-bz-node=\"bv\"]{background:var(--paper,#e6e6e4);padding-block:clamp(40px,5vw,64px)}\n[data-bz-node=\"bv\"] .bz-block{padding-block:0}\n[data-bz-node^=\"bv-col\"]{display:block;max-width:44rem;margin-inline:auto;text-align:center;padding:0}\n[data-bz-node^=\"bv-eyebrow\"] .bz-eyebrow{margin:0}\n[data-bz-node^=\"bv-h\"] h2{margin:0 0 var(--space-3)}\n[data-bz-node^=\"bv-addr\"]{margin-bottom:var(--space-4)}\n[data-bz-node^=\"bv-addr\"] p{margin:0;font-size:.9375rem;line-height:1.7;color:#3d3c39}\n[data-bz-node^=\"bv-cta\"] .bz-btns{justify-content:center;gap:12px;margin:0}\n",
  "js": ""
}
