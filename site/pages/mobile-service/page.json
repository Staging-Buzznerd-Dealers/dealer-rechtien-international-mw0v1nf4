    {
      "id": "intro",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "intro-row",
          "type": "row",
          "props": {
            "gap": 7,
            "stackOn": "mobile",
            "align": "center"
          },
          "children": [
            {
              "id": "intro-copy",
              "type": "column",
              "props": {
                "span": 8
              },
              "children": [
                {
                  "id": "intro-h",
                  "type": "heading",
                  "props": {
                    "text": "Is downtime for vehicle service and repairs impacting your business?",
                    "headingLevel": 2,
                    "align": "left",
                    "eyebrow": "Mobile service"
                  }
                },
                {
                  "id": "intro-t1",
                  "type": "text",
                  "props": {
                    "text": "With Idealease Mobile Service, you can schedule service when your vehicles are not operating — during off hours or on weekends — at your location. Highly skilled technicians and well-equipped maintenance vehicles bring service and parts to you, and can perform up to 80% of all routine and preventive commercial truck maintenance at your location.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-t2",
                  "type": "text",
                  "props": {
                    "text": "Improve vehicle uptime, reduce fuel costs and driver downtime for your fleet of five or more commercial trucks with cost-effective, convenient Mobile Service.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-t3",
                  "type": "text",
                  "props": {
                    "text": "Idealease of South Florida, with Rechtien Truck Group, offers mobile service alongside full-service semi truck leasing and dedicated maintenance. Carolina Idealease, with Rechtien Truck Group in South Carolina, also offers mobile service for its customers.",
                    "align": "left",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "intro-logo",
              "type": "column",
              "props": {
                "span": 4
              },
              "children": [
                {
