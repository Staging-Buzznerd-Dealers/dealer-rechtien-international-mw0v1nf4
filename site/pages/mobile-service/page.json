                      "src": "/logos/idealease.png",
                      "alt": "Idealease truck leasing and rental logo"
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "intro-logo-cap",
                  "type": "text",
                  "props": {
                    "text": "Mobile service through Idealease, in South Florida and South Carolina.",
                    "align": "left",
                    "width": "full"
                  }
                }
              ]
            }
          ]
        }
      ]
