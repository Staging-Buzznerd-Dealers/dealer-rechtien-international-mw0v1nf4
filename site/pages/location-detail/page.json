        "sectionId": "find-location",
        "values": {
          "eyebrow": "Find a location",
          "heading": "Other locations",
          "brandLabel": "Brand",
          "intro": "Nearby and across the network — every branch carries the same International lineup, parts and service support.",
          "states": [
            {
              "label": "Florida",
              "key": "florida",
              "icon": {
                "src": "/logos/state-florida.svg",
                "alt": "",
                "width": 64,
                "height": 64
              }
            },
            {
              "label": "Carolina",
              "key": "carolina",
              "icon": {
                "src": "/logos/state-carolina.svg",
                "alt": "",
                "width": 64,
                "height": 64
              }
            }
          ],
          "brandOptions": {
            "source": "location-brands"
          },
          "locations": {
            "source": "locations",
            "config": {
              "excludeSlug": "{{locationSlug}}",
              "pagePathPrefix": "/locations"
            }
          }
        }
      }
    },
    {
      "id": "faq",
