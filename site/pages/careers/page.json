    {
      "id": "about",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 6
      },
      "children": [
        {
          "id": "about-row",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "children": [
            {
              "id": "about-col",
