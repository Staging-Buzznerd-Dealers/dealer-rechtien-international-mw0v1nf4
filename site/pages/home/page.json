    {
      "id": "place-inventory",
      "type": "sharedSection",
      "props": {
        "sectionId": "keep-moving",
        "values": {
          "eyebrow": "Our inventory",
          "heading": "Everything to keep you moving.",
          "intro": "We make finding the right equipment from reputable brands easier than ever at Carolina-Rechtien International. Whether you need a commercial truck, trailer, or school bus, we have the equipment you need to keep your business moving.",
          "items": [
            {
              "num": "01",
              "title": "Trucks",
              "body": "Shop our wide selection of new and pre-owned International trucks built to handle any job, equipped with advanced telematics via OnCommand Connection for real-time fleet insights.",
              "ctaLabel": "Browse trucks",
              "url": "/store/inventory"
            },
            {
              "num": "02",
              "title": "Trailers",
              "body": "Explore our diverse inventory of trailers, including flatbeds, dump trailers, and reefers, from trusted brands like Dorsey and East.",
              "ctaLabel": "Browse trailers",
              "url": "/store/inventory"
            },
            {
              "num": "03",
              "title": "IC Bus",
              "body": "Built for safety and reliability, our IC Bus selection offers top-of-the-line school and commercial buses from industry-leading manufacturers.",
              "ctaLabel": "Explore models",
              "url": "/store/inventory"
            },
            {
              "num": "04",
              "title": "Yard Trucks & Forklifts",
              "body": "Kalmar Ottawa yard trucks and Navigator forklifts deliver the reliability and power your business needs to run smoothly day after day.",
              "ctaLabel": "Explore models",
              "url": "/store/inventory"
            },
            {
              "num": "05",
              "title": "Service",
              "body": "We offer full-service repairs for trucks and trailers at our certified service centers, plus mobile maintenance support so we come to you.",
              "ctaLabel": "Schedule service",
              "url": "/service"
            },
            {
              "num": "06",
              "title": "Parts",
              "body": "Order genuine parts online or in-store at our parts departments across South Florida and South Carolina.",
              "ctaLabel": "Order parts",
              "url": "/store/parts"
            },
            {
              "num": "07",
              "title": "Financing",
              "body": "Get financing options for your next truck or trailer purchase, with a team ready to walk you through it.",
              "ctaLabel": "Learn more",
              "url": "/financing"
            },
            {
              "num": "08",
              "title": "Lease & Rental Department",
              "body": "Short- and long-term leasing and rental plans backed by Idealease. To reach our Lease & Rental team, please call [LEASE & RENTAL PHONE].",
              "ctaLabel": "Learn more",
              "url": "/lease-rental"
            }
          ]
        }
