                  "id": "unique-t1",
                  "type": "text",
                  "props": {
                    "text": "Built on the same proven foundation we use in our diesel MV, we made some key placement changes including the batteries and battery controller; the motor controller and motor; the radiator and Battery Thermal Management System (BTMS); as well as the air tanks and air bag suspension.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "unique-t2",
                  "type": "text",
                  "props": {
                    "text": "Key features of the new eMV include:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "unique-grid",
                  "type": "list",
                  "props": {
                    "headingLevel": 3,
                    "columns": 1,
                    "items": [
                      {
                        "label": "210 kWh battery pack"
                      },
                      {
                        "label": "135 mile range"
                      },
                      {
                        "label": "Electric drive motor"
                      },
                      {
                        "label": "Industry leading 3 levels of regen braking"
                      },
                      {
                        "label": "AC/DC charging and capability with up to 125 kW DC fast charge"
                      },
                      {
                        "label": "New full digital display"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "unique-media",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
