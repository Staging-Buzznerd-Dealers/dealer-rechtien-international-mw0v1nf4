    {
      "id": "intro",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "intro-row",
          "type": "row",
          "props": {
            "gap": 7,
            "stackOn": "mobile",
            "align": "center"
          },
          "children": [
            {
              "id": "intro-copy",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "intro-h",
                  "type": "heading",
                  "props": {
                    "text": "Your partner for a seamless transition.",
                    "headingLevel": 2,
                    "align": "left",
                    "eyebrow": "eMobility"
                  }
                },
                {
                  "id": "intro-t1",
                  "type": "text",
                  "props": {
                    "text": "International dealers and trusted advisors provide customers with a complete eMobility solution, bringing knowledge and years of experience with technology and infrastructure to deliver customers the “just right” electric solution. It is designed to help commercial truck and bus customers implement electric vehicles via its unique consultative approach that goes beyond the vehicle, covering the entire eMobility lifecycle.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-t2",
                  "type": "text",
                  "props": {
                    "text": "Here is how Rechtien International Trucks and International help you make the transition:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "request-quote"
                      },
                      {
                        "ctaId": "explore-inventory",
                        "style": "link"
                      }
                    ],
                    "align": "left"
                  }
                }
              ]
            },
            {
              "id": "intro-media",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "intro-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/emv-truck.jpg",
                      "alt": "Blue International eMV electric box truck"
                    },
                    "width": "full"
                  }
                }
              ]
            }
          ]
        }
