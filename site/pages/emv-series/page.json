                    "headingLevel": 2,
                    "columns": 3,
                    "items": [
                      {
                        "label": "Finding the best way forward",
                        "desc": "Our discovery workshops dive into your fleet's electrification needs and concerns, building a customized EV roadmap for success."
                      },
                      {
                        "label": "Laying the groundwork",
                        "desc": "We assess the placement of hardware and infrastructure, finding the best ways to support your vehicle charging and uptime."
                      },
                      {
                        "label": "Bringing it all together",
                        "desc": "We ensure your charging locations, staff, and remote diagnostics are prepared for your electric fleet to hit the road."
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
