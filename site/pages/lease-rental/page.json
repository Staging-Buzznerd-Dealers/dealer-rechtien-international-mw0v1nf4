    {
      "id": "intro",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "intro-row",
          "type": "row",
          "props": {
            "gap": 7,
            "stackOn": "mobile",
            "align": "center"
