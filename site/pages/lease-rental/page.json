    {
      "id": "faq",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "anchor": "faq",
        "background": "paper"
      },
      "children": [
        {
          "id": "faq-row",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "children": [
            {
              "id": "faq-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "faq-h",
                  "type": "heading",
                  "props": {
                    "text": "Common questions.",
                    "headingLevel": 2,
                    "align": "left",
                    "eyebrow": "Lease & rental FAQ"
                  }
                },
                {
                  "id": "faq-list",
                  "type": "widget",
                  "props": {
                    "widget": "faq",
                    "config": {
                      "items": [
                        {
                          "q": "Should I lease, rent or buy a semi-truck?",
                          "a": "If you need a new truck for the long haul and like the freedom that comes with ownership, buying may be your best option. If you need a truck for a shorter period, want to refresh your truck periodically, or want peace of mind when it comes to maintenance, you may want to lease. If you need a truck for a short-term peak in your business, or a replacement while yours is in the shop, you can rent by the day, week, month or longer."
                        },
                        {
                          "q": "What can a leasing agreement include?",
                          "a": "At Idealease of South Florida, leasing agreements can include full-service maintenance, licensing, fuel tax reporting and washing. A Carolina Idealease full service lease includes the vehicle specs you need, predictable costs for all vehicle maintenance, Priority Service, and 24/7 Roadside Assistance."
                        },
                        {
                          "q": "What is a full service equity lease?",
                          "a": "It is a solution for companies that must own their commercial vehicles for tax purposes. You retain tax ownership and establish equity in your fleet while receiving all the benefits of a Full Service Lease."
                        },
                        {
                          "q": "How long can I rent a truck?",
                          "a": "Idealease rental programs fit your needs for a day, week, month or longer."
                        },
                        {
                          "q": "What kinds of trucks can I rent?",
                          "a": "Late-model sleepers, day cabs, flat beds, box trucks, refrigerated vehicles and more are available for rent, including a full menu of class 5, 6, 7 and 8 trucks."
                        },
                        {
                          "q": "Is roadside assistance included?",
                          "a": "IdealNet provides 24/7 roadside assistance at more than 430 Idealease locations, delivered in-house by trained Idealease staff members."
                        },
                        {
                          "q": "Can maintenance come to my location?",
                          "a": "Yes. With Idealease Mobile Service, highly skilled technicians and well-equipped maintenance vehicles bring service and parts to your location during off-hours, and can perform up to 80% of all routine and preventive commercial truck maintenance at your location."
                        },
                        {
                          "q": "Can I finance a truck instead?",
                          "a": "Yes. See our financing page for options and a credit application."
                        }
                      ]
                    },
                    "snapshot": {
                      "items": []
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
