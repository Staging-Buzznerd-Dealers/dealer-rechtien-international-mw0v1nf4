    {
      "id": "intro",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "intro-row",
          "type": "row",
          "props": {
            "gap": 6,
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "intro-l",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "intro-h",
                  "type": "heading",
                  "props": {
                    "text": "Introducing My International™. Uptime-boosting tools. All in one place.",
                    "headingLevel": 2,
                    "align": "left"
                  }
                }
              ]
            },
            {
              "id": "intro-r",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "intro-t1",
                  "type": "text",
                  "props": {
                    "text": "My International™ is a comprehensive, connected digital ecosystem that streamlines how you manage your fleet and collaborate with our dealer network. Whether you operate one truck or a thousand, we provide the real-time insights and communication tools you need to reduce costs, save time, and maximize uptime.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-t2",
                  "type": "text",
                  "props": {
                    "text": "<strong>Standard on every new build:</strong> All new class 6–8 vehicles include a factory-installed telematics device along with a 5-year connected data plan and access to My International.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-t3",
                  "type": "text",
                  "props": {
                    "text": "Everything you need, connected and in one place:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-list",
                  "type": "list",
                  "props": {
                    "columns": 1,
                    "headingLevel": 2,
                    "items": [
                      {
                        "label": "Advanced remote diagnostics and vehicle health reporting",
                        "desc": "Get instant fault code severity ratings and interactive plans to resolve issues faster."
                      },
                      {
                        "label": "Service communications",
                        "desc": "Coordinate directly with dealers and use proactive scheduling to get back on the road sooner."
                      },
                      {
                        "label": "Remote software & parameter updates",
                        "desc": "Optimize vehicle performance and update settings remotely without a service visit."
                      },
                      {
                        "label": "Fuel analytics",
                        "desc": "Access detailed performance reports to maximize the efficiency of your International® S13® integrated powertrain and A26 engine."
                      },
                      {
                        "label": "Remote lock/unlock",
                        "desc": "Avoid the downtime and expense of vehicle lockouts with instant remote access."
                      },
                      {
                        "label": "GPS tracking & geofencing",
                        "desc": "Monitor vehicle locations and set custom boundary alerts for better fleet security."
                      },
                      {
                        "label": "Warranty & contract management",
                        "desc": "View your warranty coverage and service contracts in one place, whenever you want."
                      }
                    ]
                  }
                },
                {
                  "id": "intro-foot",
                  "type": "text",
                  "props": {
                    "text": "*Availability of Fuel Analytics, Remote Lock/Unlock, and certain OTA capabilities will vary based on vehicle build date and/or powertrain configuration. Contact your International sales or connected vehicle representative with specific questions.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "intro-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "mi-log-in"
                      },
                      {
                        "ctaId": "mi-enroll"
                      }
                    ],
                    "align": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
