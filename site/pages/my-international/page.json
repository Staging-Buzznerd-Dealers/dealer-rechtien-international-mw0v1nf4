    {
      "id": "features",
      "type": "sharedSection",
      "props": {
        "sectionId": "my-int-features",
        "values": {
          "features": [
            {
              "title": "Advanced Remote Diagnostics",
              "text": "My International uses advanced analytics to transform vehicle data into clear, actionable insights. Easily monitor vehicle health and performance for greater uptime and efficiency.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/60/int25-myinternational-desktop-office-1.avif",
                "alt": "Advanced Remote Diagnostics photo placeholder"
              }
            },
            {
              "title": "Remote Lock/Unlock",
              "text": "Eliminate lockout-related downtime and expense. My International allows fleets and owner-operators to remotely unlock compatible vehicles, keeping your drivers on the road.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/11/mobile-service-2000-x-1500-px.png",
                "alt": "Remote Lock/Unlock photo placeholder",
                "width": 2000,
                "height": 1500
              }
            },
            {
              "title": "Fuel Analytics",
              "text": "My International® Fuel Analytics turns data into savings. Tracking engine speed, idle time and more, it helps lower your total cost of ownership.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/d0/int25-myinternational-fuel-analytics-1.avif",
                "alt": "Fuel Analytics photo placeholder"
              }
            },
            {
              "title": "Service Communications",
              "text": "Track your vehicle's status and review service estimates in real time. My International facilitates direct communication with your dealer and proactive scheduling to ensure faster turnaround.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/99/int25-myinternational-mobile-in-cab-map-1.avif",
                "alt": "Service Communications photo placeholder"
              }
            },
            {
              "title": "Over-the-Air Programming",
              "text": "Keep your trucks on the road, not in the shop. My International lets you update engine software and parameters remotely. You can optimize performance without a service visit.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/f3/international-person-computer-office-dealer-251017-13191.avif",
                "alt": "Over-the-Air Programming photo placeholder"
              }
            },
            {
              "title": "Gateway Integrations",
              "text": "Bring your entire fleet together. My International integrates with over 30 telematics providers, so you can manage all makes of vehicles in one place without extra hardware, gateway hubs, or installation visits.",
              "ctaLabel": "Explore",
              "ctaUrl": "#",
              "image": {
                "src": "https://vendure.ai4dealerships.com/assets/source/27/int25-myinternational-desktop-garage-1.avif",
                "alt": "Gateway Integrations photo placeholder"
              }
            }
          ]
        }
      },
      "children": []
