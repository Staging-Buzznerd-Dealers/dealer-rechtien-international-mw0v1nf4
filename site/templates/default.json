{
  "version": 2,
  "id": "default",
  "name": "Site template",
  "conditions": [{ "type": "entireSite", "ref": null }],
  "css": "/* Logo sizes. The platform sets images inside blocks to height:auto, which beats the logo block's own height,\n   so the heights are stated here (same approach as the Homepage and Inventory templates). */\n[data-bz-node=\"logo\"] .bz-logo__img{height:40px;width:auto;max-width:none}\n[data-bz-node=\"footer-logo\"] .bz-logo__img{height:36px;width:auto;max-width:none}\n@media (max-width:640px){[data-bz-node=\"logo\"] .bz-logo__img{height:32px}}\n",
  "nodes": [
    {
      "id": "header",
      "type": "section",
      "props": { "width": "boxed", "paddingY": 3, "background": "card" },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": { "gap": 5, "align": "center", "stackOn": "mobile" },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": { "span": 3, "align": "center" },
              "children": [{ "id": "logo", "type": "logo", "props": { "image": { "src": "/logos/rechtien-truck-group-logo-black.png", "alt": "International Rechtien Truck Group", "width": 1200, "height": 199 }, "url": "/", "height": 40 } }]
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": { "span": 6, "align": "center" },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": { "menuId": "main", "layout": "horizontal", "align": "center", "collapseOnMobile": true }
                }
              ]
            },
            {
              "id": "header-cta",
              "type": "column",
              "props": { "span": 3, "align": "center" },
              "children": [
                {
                  "id": "header-button",
                  "type": "buttons",
                  "props": { "items": [{ "ctaId": "browse-inventory" }], "align": "left" }
                }
              ]
            }
          ]
        }
      ]
    },
    { "id": "content", "type": "contentArea", "props": { "label": "Page content" } },
    {
      "id": "footer",
      "type": "section",
      "props": { "width": "boxed", "paddingY": 7, "background": "ink" },
      "children": [
        {
          "id": "footer-row",
          "type": "row",
          "props": { "gap": 6, "align": "start" },
          "children": [
            {
              "id": "footer-brand",
              "type": "column",
              "props": { "span": 4 },
              "children": [{ "id": "footer-logo", "type": "logo", "props": { "image": { "src": "/logos/rechtien-truck-group-logo-white.png", "alt": "International Rechtien Truck Group", "width": 1200, "height": 199 }, "url": "/", "height": 36 } }]
            },
            {
              "id": "footer-links",
              "type": "column",
              "props": { "span": 4 },
              "children": [
                { "id": "footer-nav", "type": "menu", "props": { "menuId": "footer", "layout": "vertical" } }
              ]
            },
            {
              "id": "footer-legal",
              "type": "column",
              "props": { "span": 4 },
              "children": [
                { "id": "legal-nav", "type": "menu", "props": { "menuId": "legal", "layout": "vertical" } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
