{
  "id": "my-international-renewal",
  "name": "My International subscription renewal",
  "status": "live",
  "system": false,
  "pdpContext": false,
  "surfaces": [
    "page"
  ],
  "intent": "my-international-renewal",
  "submitLabel": "Submit renewal request",
  "successMessage": "Thank you. Your renewal request has been received. Our Service Contracts team will follow up with pricing and next steps.",
  "consent": {
    "enabled": true,
    "required": true,
    "text": "I agree to be contacted about my My International subscription by phone, text or email."
  },
  "fields": [
    {
      "id": "mir-first",
      "type": "first_name",
      "label": "First name",
      "required": true,
      "width": "half"
    },
    {
      "id": "mir-last",
      "type": "last_name",
      "label": "Last name",
      "required": true,
      "width": "half"
    },
    {
      "id": "mir-email",
      "type": "email",
      "label": "Email",
      "required": true,
      "width": "half"
    },
    {
      "id": "mir-phone",
      "type": "phone",
      "label": "Phone",
      "required": false,
      "width": "half"
    },
    {
      "id": "mir-company",
      "type": "text",
      "label": "Company",
      "required": false
    },
    {
      "id": "mir-vin",
      "type": "text",
      "label": "Vehicle VIN",
      "required": false
    },
    {
      "id": "mir-term",
      "type": "radio",
      "label": "Renewal term",
      "required": true,
      "options": [
        {
          "value": "12-months",
          "label": "12 months"
        },
        {
          "value": "24-months",
          "label": "24 months"
        }
      ]
    },
    {
      "id": "mir-message",
      "type": "paragraph",
      "label": "Message",
      "required": false
    }
  ],
  "notifications": [
    {
      "id": "my-international-renewal-default",
      "name": "Default",
      "logic": "AND",
      "rules": [],
      "targetType": "role",
      "roleId": "service-advisor",
      "scopeMode": "dynamic"
    }
  ]
}
